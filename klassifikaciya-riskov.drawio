<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Grok" version="24.7.0" type="device">
  <diagram id="risk-class" name="Классификация рисков">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c" value="КЛАССИФИКАЦИЯ&lt;br&gt;РИСКОВ ПРОЕКТА&lt;br&gt;&lt;font style='font-size: 11px' color='#D1D5DB'&gt;Веб-приложение для точки&lt;br&gt;кофе и чая на развес&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#111827;fontColor=#FFFFFF;fontStyle=1;fontSize=16;arcSize=12;shadow=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="740" y="455" width="300" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="tech" value="ТЕХНИЧЕСКИЙ РИСК" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#115E59;fontColor=#FFFFFF;fontStyle=1;fontSize=12;arcSize=20;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="210" width="210" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="mgmt" value="УПРАВЛЕНЧЕСКИЙ РИСК" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9D174D;strokeColor=#831843;fontColor=#FFFFFF;fontStyle=1;fontSize=12;arcSize=20;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="180" width="230" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="comm" value="КОММЕРЧЕСКИЙ РИСК" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3730A3;strokeColor=#312E81;fontColor=#FFFFFF;fontStyle=1;fontSize=12;arcSize=20;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="730" width="210" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="ext" value="ВНЕШНИЙ РИСК" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=#92400E;fontColor=#FFFFFF;fontStyle=1;fontSize=12;arcSize=20;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="720" width="200" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="t1" value="&lt;b&gt;Содержание&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Точка кофе и чая на развес: в середине спринта хозяин добавил доставку по району, хотя в скоупе были каталог и база постоянных&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#CCFBF1;strokeColor=#14B8A6;fontColor=#134E4A;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;Требования&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Цена на развес зависит от фасовки и остатка, в ТЗ не зафиксировали, как витрина и заказ округляют граммы и обновляют прайс&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#CCFBF1;strokeColor=#14B8A6;fontColor=#134E4A;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;Технология&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Ограничение «заказ только в своём районе» не закрылось готовой картой — геозону для спального района Москвы пришлось писать отдельно&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#CCFBF1;strokeColor=#14B8A6;fontColor=#134E4A;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="196" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;Технические процессы&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Каталог выкатили без сверки: на прилавке чай 450 ₽/100 г, на сайте старая цена, касса и витрина разъехались&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#CCFBF1;strokeColor=#14B8A6;fontColor=#134E4A;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="282" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;Интеграция&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Номенклатуры нет: Excel-прайс, ценники на банках и веб-каталог правятся по отдельности после каждой поставки зерна&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#CCFBF1;strokeColor=#14B8A6;fontColor=#134E4A;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="368" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="&lt;b&gt;Управление проектом&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Хозяин заложил 700 тыс. ₽ и два месяца — каталог, база и заказы по району не умещаются в срок без сжатия теста&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#FCE7F3;strokeColor=#F472B6;fontColor=#831843;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1310" y="24" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;Управление программой и портфелем&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Параллельно просит рассылку акций постоянным, это забирает тех же людей, что собирают каталог в те же 8 недель&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#FCE7F3;strokeColor=#F472B6;fontColor=#831843;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1310" y="110" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;Обеспечение ресурсами&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Один разработчик на витрину и админку: болезнь на неделе запуска оставляет точку без онлайн-заказов&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#FCE7F3;strokeColor=#F472B6;fontColor=#831843;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1310" y="196" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="&lt;b&gt;Коммуникации&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Хозяин считает сайт готовым, когда витрина открылась; команда — когда заказ по району доходит до прилавка&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#FCE7F3;strokeColor=#F472B6;fontColor=#831843;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1310" y="282" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="k1" value="&lt;b&gt;Договорные условия&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Фикс 700 тыс. ₽ на два месяца: в договоре не отрезан MVP, хозяин ждёт и каталог, и базу, и заказ по району&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#E0E7FF;strokeColor=#6366F1;fontColor=#312E81;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="k2" value="&lt;b&gt;Поставщики, подрядчики, субподрядчики&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Сервис SMS для скидок постоянным задержал шаблоны, акцию по району некому разослать к открытию&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#E0E7FF;strokeColor=#6366F1;fontColor=#312E81;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="686" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="k3" value="&lt;b&gt;Материально-техническое снабжение&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Весы на развес без обмена с каталогом: фасовка в граммах не попадает в позицию заказа на сайте&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#E0E7FF;strokeColor=#6366F1;fontColor=#312E81;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="772" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="k4" value="&lt;b&gt;Стабильность контрагента&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Курьер по спальному району отказался от мелких пакетов чая, канал «интернет только в районе» остался без доставки&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#E0E7FF;strokeColor=#6366F1;fontColor=#312E81;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="858" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="&lt;b&gt;Законодательство&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: База постоянных с телефоном под скидку и онлайн-заказ: 152-ФЗ и чек по 54-ФЗ не заложены в два месяца&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1310" y="620" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;Курсы валют&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Зелёный кофе закупается в валюте, курс скачет, цены в каталоге устаревают быстрее, чем хозяин успевает обновить витрину&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1310" y="706" width="450" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;Конкуренция&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px' color='#4A5568'&gt;Пример: Сети и маркетплейсы возят кофе в тот же дом, случайные прохожие не конвертируются в постоянных даже со скидкой в приложении&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1310" y="792" width="450" height="78" as="geometry"/>
        </mxCell>
